{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/admin/:path*", "destination": "/api/admin?path=:path*" },
    { "source": "/:lang(en|az|ru)/blog/:slug", "destination": "/api/article?lang=:lang&slug=:slug" },
    { "source": "/blog/:slug", "destination": "/api/article?slug=:slug" }
  ]
}
